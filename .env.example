# ─────────────────────────────────────────────────────────────
# Muse — environment
# Copy to .env.local for development:  cp .env.example .env.local
# NEVER commit .env.local. Only NEXT_PUBLIC_* vars reach the browser.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────
# From `supabase start` (local) or the project dashboard (hosted).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ── Anthropic (server-side only) ─────────────────────────────
# Leave ANTHROPIC_API_KEY empty and MOCK_AI=true to run without a key.
ANTHROPIC_API_KEY=
MOCK_AI=true
ANTHROPIC_MODEL_CLASSIFY=claude-sonnet-4-6
ANTHROPIC_MODEL_BRIEF=claude-sonnet-4-6
ANTHROPIC_MODEL_ASK=claude-sonnet-4-6
ANTHROPIC_MODEL_PRIORITIZE=claude-sonnet-4-6
ANTHROPIC_MODEL_REFLECT=claude-sonnet-4-6
ANTHROPIC_MODEL_THREADS=claude-sonnet-4-6

# ── Embeddings ───────────────────────────────────────────────
# Provider: voyage | openai | none.  Absent key => embeddings skipped silently.
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=voyage-3-lite
EMBEDDINGS_DIMENSION=1024
VOYAGE_API_KEY=

# ── AI cost guardrails (per user per day) ────────────────────
AI_DAILY_BUDGET_PAID=50
AI_DAILY_BUDGET_FREE=10

# ── Rate limits (requests per minute per user) ───────────────
RATE_LIMIT_GENERAL=60
RATE_LIMIT_AI=10
RATE_LIMIT_CAPTURE_TOKEN=30
# Optional Upstash Redis. Absent => Postgres-backed limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Web Push (VAPID) ─────────────────────────────────────────
# Generate:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@muse.app

# ── Cron (Vercel Cron / pg_cron caller auth) ─────────────────
CRON_SECRET=replace-with-long-random-string

# ── Razorpay (subscriptions, INR) ────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_INTELLIGENCE=
NEXT_PUBLIC_PRICE_INTELLIGENCE_INR=299

# ── Google OAuth (Calendar push-sync; Auth is configured in Supabase) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# ── Email (weekly digest, Resend). Absent => log-only in dev. ──
RESEND_API_KEY=
EMAIL_FROM=Muse <hello@muse.app>

# ── Admin ────────────────────────────────────────────────────
# Comma-separated allowlist of emails permitted to load /admin.
ADMIN_EMAILS=

# ── Observability (env-gated; absent => disabled) ────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Defaults ─────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_BRIEF_TIME=07:30
TRASH_RETENTION_DAYS=30
